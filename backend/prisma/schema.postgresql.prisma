generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  email         String?  @unique   // empty for people who signed up with a phone number
  // Ghanaian mobile in +233 format. Saved only after the number has been confirmed with a code.
  phone         String?  @unique
  phoneVerifiedAt DateTime?
  password      String
  role          String   @default("SEEKER")
  status        String   @default("ACTIVE") // ACTIVE, FLAGGED, SUSPENDED
  emailVerified Boolean  @default(false)
  identityVerified Boolean @default(false)
  tokenVersion  Int      @default(0)
  preferredCurrency String @default("GHS")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobSeekerProfile   JobSeekerProfile?
  employerProfile    EmployerProfile?
  freelancerProfile  FreelancerProfile?

  jobsPosted          Job[] @relation("EmployerPostedJobs")
  adminPostedJobs     Job[] @relation("AdminPostedJobs")
  applications        Application[]
  freelanceServices   FreelanceService[]
  
  messagesSent        Message[] @relation("SentMessages")
  conversationsAsUser1 Conversation[] @relation("ConversationUser1")
  conversationsAsUser2 Conversation[] @relation("ConversationUser2")

  cvGenerations       CVGeneration[]
  reportsSubmitted    Report[] @relation("Reporter")
  reportsReceived     Report[] @relation("ReportedUser")
  serviceRequestsSent ServiceRequest[] @relation("ServiceRequestClient")
  employerAgreements  Agreement[] @relation("EmployerAgreements")
  seekerAgreements    Agreement[] @relation("SeekerAgreements")
  freelancerAgreements Agreement[] @relation("FreelancerAgreements")
  clientAgreements    Agreement[] @relation("ClientAgreements")
  agreementEvents     AgreementEvent[]
  proposalsCreated    Proposal[] @relation("ProposalCreator")
  proposalsReceived   Proposal[] @relation("ProposalRecipient")
  proposalRevisions   ProposalRevision[] @relation("ProposalRevisionAuthor")
  notifications       Notification[]
  savedSearches       SavedSearch[]
  savedJobs           SavedJob[]
  seekerCv            SeekerCv?
  paymentsSent        Payment[] @relation("PaymentPayer")
  paymentsReceived    Payment[] @relation("PaymentPayee")
  reviewsWritten      Review[]  @relation("ReviewAuthor")
  reviewsReceived     Review[]  @relation("ReviewRecipient")
  disputesCreated     AgreementDispute[] @relation("DisputeCreator")
  disputesReceived    AgreementDispute[] @relation("DisputeCounterparty")
  disputesResolved    AgreementDispute[] @relation("DisputeResolver")
  verificationRequests VerificationRequest[] @relation("VerificationRequester")
  verificationReviews   VerificationRequest[] @relation("VerificationReviewer")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  payoutAccount           PayoutAccount?
  disputeMessages         DisputeMessage[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model JobSeekerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  firstName   String?
  lastName    String?
  skills      String   @default("")
  experience  String?
  resumeFileUrl String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmployerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyName String
  industry    String?
  logoUrl     String?
  website     String?
  description String?
  // How quickly this employer first responds to applicants (a running average, kept up to date as they respond).
  avgResponseHours Float?
  responseCount    Int     @default(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FreelancerProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  firstName     String?
  lastName      String?
  tagline       String?
  hourlyRate    Float?
  availability  String   @default("AVAILABLE") // AVAILABLE, BUSY, OUT_OF_OFFICE
  location      String?  // Accra, Kumasi, Tema, etc.
  portfolioUrl  String?
  bio           String?
  skills        String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects      PortfolioProject[]
}

model PortfolioProject {
  id                  String   @id @default(uuid())
  freelancerProfileId String
  title               String
  description         String
  imageUrl            String?
  projectUrl          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  @@index([freelancerProfileId])
}

model Job {
  id          String   @id @default(uuid())
  employerId  String
  postedByAdminId String?
  postedByAdminAt DateTime?
  title       String
  description String
  location    String?
  type        String   // Full-time, Part-time, Contract, etc.
  salary      String?   // the pay as the employer wrote it, shown to people
  // The same pay as numbers, in Ghana cedis per month, so jobs can be searched by salary. salaryMax empty = a single figure.
  salaryMin   Int?
  salaryMax   Int?
  salaryParsedAt DateTime? // set once we have tried to read numbers out of old text pay
  currency    String   @default("GHS")
  category    String?
  status      String   @default("ACTIVE") // DRAFT, ACTIVE, PAUSED, CLOSED, EXPIRED (owner); FLAGGED, SUSPENDED (admin)
  // Last day the job can be applied for. Existing rows and admin-posted jobs get 30 days from creation.
  closesAt    DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + interval '30 days')"))
  expiryWarningSentAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employer     User          @relation("EmployerPostedJobs", fields: [employerId], references: [id], onDelete: Cascade)
  postedByAdmin User?        @relation("AdminPostedJobs", fields: [postedByAdminId], references: [id], onDelete: SetNull)
  applications Application[]
  reports      Report[]      @relation("ReportedJob")
  savedBy      SavedJob[]

  @@index([employerId])
  @@index([postedByAdminId])
  @@index([status, category, createdAt])
  @@index([category, status])
  @@index([location, status])
  @@index([type, status])
  @@index([createdAt])
  @@index([status, closesAt])
  @@index([salaryMax])
}

model Application {
  id          String    @id @default(uuid())
  jobId       String
  seekerId    String
  coverLetter String?
  status      String   @default("SUBMITTED") // SUBMITTED (shown as New), SHORTLISTED, INTERVIEW, OFFERED, REJECTED, HIRED, COMPLETED, CANCELLED
  // When the status last changed (null on older rows: use updatedAt).
  statusChangedAt DateTime?
  // When the employer first moved it out of New. Used for response-time stats.
  firstRespondedAt DateTime?
  // Set once the employer has been reminded that this application sat in New for 14 days.
  newReminderSentAt DateTime?
  // The CV the applicant chose to send, copied at the moment they applied (UPLOADED or BUILDER). Only this employer can open it.
  cvSource    String?
  cvFileUrl   String?
  cvFileName  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime  @updatedAt

  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker    User      @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  agreement Agreement?
  proposals Proposal[]
  review    ApplicationReview?

  @@unique([jobId, seekerId])
  @@index([jobId, status])
  @@index([seekerId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model FreelanceService {
  id          String   @id @default(uuid())
  freelancerId String
  title       String
  description String
  price       Float
  currency    String   @default("GHS")
  deliveryTime String?
  category    String?
  status      String   @default("ACTIVE") // ACTIVE, FLAGGED, SUSPENDED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  freelancer  User     @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  reports     Report[] @relation("ReportedService")
  serviceRequests ServiceRequest[]

  @@index([freelancerId])
  @@index([status, category, createdAt])
  @@index([category, status])
  @@index([createdAt])
}

model ServiceRequest {
  id        String   @id @default(uuid())
  serviceId String
  clientId  String
  message   String
  budget    String?
  timeline  String?
  status    String   @default("PENDING") // PENDING, ACCEPTED, DECLINED, COMPLETED, CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service   FreelanceService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  client    User             @relation("ServiceRequestClient", fields: [clientId], references: [id], onDelete: Cascade)
  agreement Agreement?
  proposals Proposal[]

  @@index([serviceId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model Proposal {
  id               String   @id @default(uuid())
  applicationId    String?
  serviceRequestId String?
  creatorId        String
  recipientId      String
  type             String   // JOB, SERVICE
  status           String   @default("PENDING") // PENDING, COUNTERED, ACCEPTED, REJECTED, EXPIRED, CANCELLED
  title            String
  summary          String
  amount           String?
  timeline         String?
  expiresAt        DateTime?
  acceptedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  application    Application?    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  creator        User            @relation("ProposalCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  recipient      User            @relation("ProposalRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  revisions      ProposalRevision[]

  @@index([applicationId])
  @@index([serviceRequestId])
  @@index([creatorId])
  @@index([recipientId])
  @@index([status])
  @@index([updatedAt])
  @@index([expiresAt])
}

model ProposalRevision {
  id        String   @id @default(uuid())
  proposalId String
  authorId  String
  summary   String
  amount    String?
  timeline  String?
  message   String?
  createdAt DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  author   User     @relation("ProposalRevisionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
  @@index([authorId])
}

model Agreement {
  id               String   @id @default(uuid())
  type             String   // JOB, SERVICE
  title            String
  summary          String?
  amount           String?
  currency         String   @default("GHS")
  status           String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  applicationId    String?  @unique
  serviceRequestId String?  @unique
  employerId       String?
  seekerId         String?
  freelancerId     String?
  clientId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  application    Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  employer       User?           @relation("EmployerAgreements", fields: [employerId], references: [id], onDelete: SetNull)
  seeker         User?           @relation("SeekerAgreements", fields: [seekerId], references: [id], onDelete: SetNull)
  freelancer     User?           @relation("FreelancerAgreements", fields: [freelancerId], references: [id], onDelete: SetNull)
  client         User?           @relation("ClientAgreements", fields: [clientId], references: [id], onDelete: SetNull)
  events         AgreementEvent[]
  milestones     AgreementMilestone[]
  payments       Payment[]
  reviews        Review[]
  disputes       AgreementDispute[]

  @@index([status])
  @@index([createdAt])
  @@index([employerId])
  @@index([seekerId])
  @@index([freelancerId])
  @@index([clientId])
}

model Review {
  id         String   @id @default(uuid())
  agreementId String
  reviewerId String
  revieweeId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  agreement  Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  reviewer   User      @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee   User      @relation("ReviewRecipient", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([agreementId, reviewerId])
  @@index([revieweeId, createdAt])
  @@index([reviewerId, createdAt])
  @@index([rating])
}

model AgreementDispute {
  id             String   @id @default(uuid())
  agreementId    String
  creatorId      String
  counterpartyId String?
  resolverId     String?
  type           String   // PAYMENT, DELIVERY, QUALITY, COMMUNICATION, OTHER
  status         String   @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED, DISMISSED
  title          String
  description    String
  evidenceUrl    String?
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agreement      Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  creator        User      @relation("DisputeCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  counterparty   User?     @relation("DisputeCounterparty", fields: [counterpartyId], references: [id], onDelete: SetNull)
  resolver       User?     @relation("DisputeResolver", fields: [resolverId], references: [id], onDelete: SetNull)
  messages       DisputeMessage[]

  @@index([agreementId, createdAt])
  @@index([creatorId, createdAt])
  @@index([counterpartyId, createdAt])
  @@index([resolverId, createdAt])
  @@index([status, createdAt])
  @@index([type, status])
}

model DisputeMessage {
  id          String   @id @default(uuid())
  disputeId   String
  senderId    String
  content     String
  evidenceUrl String?
  createdAt   DateTime @default(now())

  dispute     AgreementDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  sender      User             @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([disputeId, createdAt])
  @@index([senderId])
}

model VerificationRequest {
  id          String   @id @default(uuid())
  userId      String
  reviewerId  String?
  type        String   // IDENTITY, BUSINESS, PROFESSIONAL
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  details     String
  documentUrl String?   // for a business: the registration certificate
  // Business verification: Registrar-General number, company contact (verified by one-time code) and address.
  registrationNumber String?
  contactEmail String?
  contactPhone String?
  address     String?
  contactVerifiedAt DateTime?
  contactVerifiedVia String?   // EMAIL or PHONE
  reviewNote  String?
  internalNote String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation("VerificationRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewer    User?    @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  contactCodes ContactVerificationCode[]

  @@index([userId, createdAt])
  @@index([reviewerId, createdAt])
  @@index([status, createdAt])
  @@index([type, status])
}

model AgreementEvent {
  id         String   @id @default(uuid())
  agreementId String
  actorId    String?
  eventType  String
  message    String
  fromStatus String?
  toStatus   String?
  createdAt  DateTime @default(now())

  agreement  Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([agreementId, createdAt])
  @@index([actorId])
}

model AgreementMilestone {
  id          String   @id @default(uuid())
  agreementId String
  title       String
  description String?
  amount      String?
  currency    String   @default("GHS")
  dueDate     DateTime?
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  paymentStatus String @default("PENDING") // PENDING, REQUESTED, PAID
  paymentRequestedAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  payments    Payment[]

  @@index([agreementId])
  @@index([status])
  @@index([paymentStatus])
  @@index([dueDate])
}

model Payment {
  id           String   @id @default(uuid())
  agreementId   String
  milestoneId   String
  payerId      String
  payeeId      String
  provider     String   @default("SANDBOX")
  status       String   @default("PENDING") // PENDING, PROCESSING, SUCCEEDED, FAILED, CANCELLED
  amount       String
  currency     String   @default("GHS")
  providerAmount Int?
  reference    String   @unique
  checkoutUrl  String?
  failureReason String?
  
  // Escrow & Payout tracking
  transferId    String?   @unique // Paystack transfer reference for payout
  payoutStatus  String    @default("NONE") // NONE, PENDING, PROCESSING, SUCCESS, FAILED
  payoutAmount  String?   // Net amount sent to freelancer (after fees)
  platformFee   String?   // JobWahala fee if applicable

  payoutAttemptedAt DateTime? // Idempotency guard for payout worker

  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agreement    Agreement          @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  milestone    AgreementMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  payer        User               @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Cascade)
  payee        User               @relation("PaymentPayee", fields: [payeeId], references: [id], onDelete: Cascade)

  @@index([agreementId, createdAt])
  @@index([milestoneId, createdAt])
  @@index([payerId])
  @@index([payeeId])
  @@index([status])
  @@index([payoutStatus])
  @@index([createdAt])
}

model Conversation {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1     User      @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User      @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([user1Id])
  @@index([user2Id])
  @@index([updatedAt])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String?
  attachmentUrl  String?
  attachmentName String?
  attachmentContentType String?
  attachmentSizeBytes Int?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([read])
}

model CVGeneration {
  id        String   @id @default(uuid())
  userId    String
  prompt    String?
  content   String // Markdown or JSON output
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  actionUrl String?
  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([type])
}

model SavedSearch {
  id            String    @id @default(uuid())
  userId        String
  query         String?
  location      String?
  jobType       String?
  emailAlerts   Boolean   @default(true)
  lastAlertedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PayoutAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  bankCode      String   // Paystack bank code (e.g. "MTN", "000013")
  bankName      String
  accountNumber String
  accountName   String
  recipientCode String   // RCP_xxxxx from Paystack
  type          String   @default("mobile_money") // mobile_money or ghipss
  currency      String   @default("GHS")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Report {
  id          String   @id @default(uuid())
  reporterId  String
  jobId       String?
  serviceId   String?
  reportedUserId String?
  reason      String
  status      String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt   DateTime @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  job      Job? @relation("ReportedJob", fields: [jobId], references: [id], onDelete: SetNull)
  service  FreelanceService? @relation("ReportedService", fields: [serviceId], references: [id], onDelete: SetNull)
  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([jobId])
  @@index([serviceId])
  @@index([reportedUserId])
  @@index([status])
  @@index([createdAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// People who asked to be told when something launches (e.g. freelance gigs). Public form, no account needed.
model InterestSignup {
  id        String   @id @default(uuid())
  email     String?
  phone     String?
  source    String
  createdAt DateTime @default(now())

  @@unique([email, source])
  @@unique([phone, source])
  @@index([source, createdAt])
}

// One-time codes sent to a company's contact email (or phone, once SMS is set up). Only a hash is stored.
model ContactVerificationCode {
  id                    String   @id @default(uuid())
  verificationRequestId String
  channel               String   @default("EMAIL") // EMAIL, PHONE
  target                String
  codeHash              String
  expiresAt             DateTime
  attempts              Int      @default(0)
  consumedAt            DateTime?
  createdAt             DateTime @default(now())

  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  @@index([verificationRequestId, createdAt])
}

// Who did what, and why. Admin ids and emails are copied in, so the record outlives the account.
model AdminActionLog {
  id         String   @id @default(uuid())
  adminId    String
  adminEmail String
  action     String   // e.g. VERIFICATION_APPROVED, VERIFICATION_REJECTED, VERIFICATION_NEEDS_INFO
  targetType String   // e.g. VerificationRequest
  targetId   String
  reason     String?
  metadata   String?  // JSON
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([adminId, createdAt])
  @@index([createdAt])
}

// One-time codes sent by SMS: sign-up, log-in, adding a phone to an account, and employer verification.
// Only a keyed hash of the code is stored. requestIp lets us cap sends per IP address.
model PhoneOtp {
  id         String   @id @default(uuid())
  phone      String
  purpose    String   // SIGNUP, LOGIN, ADD_PHONE, EMPLOYER_VERIFICATION
  subjectId  String?  // the user (ADD_PHONE) or verification request (EMPLOYER_VERIFICATION) the code is for
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  consumedAt DateTime?
  requestIp  String?
  createdAt  DateTime @default(now())

  @@index([phone, createdAt])
  @@index([requestIp, createdAt])
}

// A job a seeker bookmarked to come back to.
model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

// A job seeker's CV files. Kept apart from the public-ish profile so a file address can never travel
// out with a profile by accident. Both are private uploads, opened only through signed links.
model SeekerCv {
  id               String    @id @default(uuid())
  userId           String    @unique
  uploadedUrl      String?   // a PDF or Word file they uploaded
  uploadedFileName String?
  uploadedAt       DateTime?
  builderUrl       String?   // the Word file made by the CV builder
  builderFileName  String?
  builderSavedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// The employer's private notes and 1-5 rating on an applicant. Kept in its own table so it can never be
// returned to the applicant along with the application. Only the employer who owns the job reads or writes it.
model ApplicationReview {
  id            String   @id @default(uuid())
  applicationId String   @unique
  employerId    String
  rating        Int?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([employerId])
}
