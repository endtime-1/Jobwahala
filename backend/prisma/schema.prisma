generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String   @id @default(uuid())
  email         String?  @unique   // empty for people who signed up with a phone number
  // Ghanaian mobile in +233 format. Saved only after the number has been confirmed with a code.
  phone         String?  @unique
  phoneVerifiedAt DateTime?
  // Google account linked for "Continue with Google" (Google permanent id for the person).
  googleId      String?  @unique
  password      String
  role          String   @default("SEEKER")
  status        String   @default("ACTIVE") // ACTIVE, FLAGGED, SUSPENDED
  emailVerified Boolean  @default(false)
  identityVerified Boolean @default(false)
  tokenVersion  Int      @default(0)
  preferredCurrency String @default("GHS")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobSeekerProfile   JobSeekerProfile?
  // Courses: as a training provider, as a learner, and enquiries made.
  courses             Course[] @relation("ProviderCourses")
  billingPayments     BillingPayment[] @relation("BillingPayments")
  teamMembers         TeamMember[] @relation("TeamOwner")
  teamMemberships     TeamMember[] @relation("TeamMembership")
  cvUnlocksMade       CvUnlock[] @relation("CvUnlocksByEmployer")
  cvUnlocksReceived   CvUnlock[] @relation("CvUnlocksOfSeeker")
  cvViewsMade         CvProfileView[] @relation("CvViewsByEmployer")
  cvViewsReceived     CvProfileView[] @relation("CvViewsOfSeeker")
  cvBlocksMade        CvBlock[] @relation("CvBlocksBySeeker")
  cvBlocksReceived    CvBlock[] @relation("CvBlocksAgainstEmployer")
  savedCandidateSearches SavedCandidateSearch[] @relation("SavedCandidateSearches")
  candidateInvitesSent     CandidateInvite[] @relation("CandidateInvitesSent")
  candidateInvitesReceived CandidateInvite[] @relation("CandidateInvitesReceived")
  subscriptions       Subscription[] @relation("Subscriptions")
  creditAccount       CreditAccount? @relation("CreditAccount")
  learnerCourses      LearnerCourse[] @relation("LearnerCourses")
  courseEnquiries     CourseEnquiry[] @relation("CourseEnquiries")
  employerProfile    EmployerProfile?
  freelancerProfile  FreelancerProfile?

  jobsPosted          Job[] @relation("EmployerPostedJobs")
  adminPostedJobs     Job[] @relation("AdminPostedJobs")
  applications        Application[]
  freelanceServices   FreelanceService[]
  
  messagesSent        Message[] @relation("SentMessages")
  conversationsAsUser1 Conversation[] @relation("ConversationUser1")
  conversationsAsUser2 Conversation[] @relation("ConversationUser2")

  cvGenerations       CVGeneration[]
  reportsSubmitted    Report[] @relation("Reporter")
  reportsReceived     Report[] @relation("ReportedUser")
  serviceRequestsSent ServiceRequest[] @relation("ServiceRequestClient")
  employerAgreements  Agreement[] @relation("EmployerAgreements")
  seekerAgreements    Agreement[] @relation("SeekerAgreements")
  freelancerAgreements Agreement[] @relation("FreelancerAgreements")
  clientAgreements    Agreement[] @relation("ClientAgreements")
  agreementEvents     AgreementEvent[]
  proposalsCreated    Proposal[] @relation("ProposalCreator")
  proposalsReceived   Proposal[] @relation("ProposalRecipient")
  proposalRevisions   ProposalRevision[] @relation("ProposalRevisionAuthor")
  notifications       Notification[]
  savedSearches       SavedSearch[]
  savedJobs           SavedJob[]
  seekerCv            SeekerCv?
  paymentsSent        Payment[] @relation("PaymentPayer")
  paymentsReceived    Payment[] @relation("PaymentPayee")
  reviewsWritten      Review[]  @relation("ReviewAuthor")
  reviewsReceived     Review[]  @relation("ReviewRecipient")
  disputesCreated     AgreementDispute[] @relation("DisputeCreator")
  disputesReceived    AgreementDispute[] @relation("DisputeCounterparty")
  disputesResolved    AgreementDispute[] @relation("DisputeResolver")
  verificationRequests VerificationRequest[] @relation("VerificationRequester")
  verificationReviews   VerificationRequest[] @relation("VerificationReviewer")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  payoutAccount           PayoutAccount?
  disputeMessages         DisputeMessage[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model JobSeekerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  firstName   String?
  lastName    String?
  skills      String   @default("")
  experience  String?
  resumeFileUrl String?
  // Early career: STUDENT, NSS or GRADUATE, used to show the most relevant internships and graduate jobs first.
  // CV database: HIDDEN (the default) or VERIFIED_EMPLOYERS. Name, phone, email and the CV file stay private until an employer unlocks the profile.
  cvVisibility   String  @default("HIDDEN")
  headline       String?
  location       String?
  educationLevel String? // SECONDARY, CERTIFICATE, DIPLOMA, BACHELORS, MASTERS, DOCTORATE
  availability   String? // IMMEDIATELY, NSS, INTERNSHIP, FULL_TIME
  yearsExperience Int?
  jobCategory    String?
  lastActiveAt   DateTime?
  cvVisibleSince DateTime? // when the person last chose to be visible: what saved-search alerts count as new
  // A paid boost shows this profile higher in CV database results, marked "Boosted", until this time.
  profileBoostedUntil DateTime?
  careerStage    String?
  institution    String?
  programme      String?
  completionYear Int?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cvVisibility, profileBoostedUntil])
}

model EmployerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyName String
  industry    String?
  logoUrl     String?
  website     String?
  description String?
  // How quickly this employer first responds to applicants (a running average, kept up to date as they respond).
  avgResponseHours Float?
  responseCount    Int     @default(0)
  // A company that also runs courses. The admin approves it before its courses can be public.
  isTrainingProvider Boolean @default(false)
  providerStatus     String  @default("NONE") // NONE, PENDING, APPROVED, REJECTED
  providerReviewNote String?
  providerReviewedAt DateTime?
  // Branded company page (plans that include it). Kept if the plan ends; just not shown.
  coverImageUrl String?
  galleryJson   String @default("[]")
  whyWorkWithUs String?

  // Employer acquisition. A company JobWahala set up for an employer who sent vacancies by WhatsApp is UNCLAIMED
  // until the owner takes it over with a claim link (see CompanyClaim); every normal sign-up is CLAIMED.
  claimStatus        String   @default("CLAIMED") // CLAIMED, UNCLAIMED
  createdByAdminId   String?
  contactPhone       String?  // only for companies an admin set up: where the claim link goes
  // Founding Employers: the first companies (the limit is in BillingSettings), with a badge and free featured credits.
  isFoundingEmployer Boolean  @default(false)
  foundingNumber     Int?     @unique
  foundingAt         DateTime?
  // Referral: this company's own code, who referred it, and when the referrer was rewarded (once).
  referralCode       String?  @unique
  referredById       String?
  referralRewardedAt DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([referredById])
  @@index([claimStatus])
}

model FreelancerProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  firstName     String?
  lastName      String?
  tagline       String?
  hourlyRate    Float?
  availability  String   @default("AVAILABLE") // AVAILABLE, BUSY, OUT_OF_OFFICE
  location      String?  // Accra, Kumasi, Tema, etc.
  portfolioUrl  String?
  bio           String?
  skills        String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects      PortfolioProject[]
}

model PortfolioProject {
  id                  String   @id @default(uuid())
  freelancerProfileId String
  title               String
  description         String
  imageUrl            String?
  projectUrl          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  @@index([freelancerProfileId])
}

model Job {
  id          String   @id @default(uuid())
  employerId  String
  postedByAdminId String?
  postedByAdminAt DateTime?
  title       String
  description String
  location    String?
  type        String   // Full-time, Part-time, Contract, etc.
  salary      String?   // the pay as the employer wrote it, shown to people
  // The same pay as numbers, in Ghana cedis per month, so jobs can be searched by salary. salaryMax empty = a single figure.
  salaryMin   Int?
  salaryMax   Int?
  salaryParsedAt DateTime? // set once we have tried to read numbers out of old text pay
  // Paid promotion: both end by themselves (every query compares them to now).
  featuredUntil DateTime?
  boostedUntil  DateTime? // "Urgently hiring"
  currency    String   @default("GHS")
  category    String?
  // Early-career details (internships, National Service, attachments, graduate jobs). For these types the pay
  // numbers above are the monthly stipend; unpaid = true says so plainly and leaves them empty.
  unpaid            Boolean   @default(false)
  durationMonths    Int?
  startsImmediately Boolean   @default(false)
  startDate         DateTime?
  schedule          String? // FULL_TIME or PART_TIME
  possibleJobOffer  Boolean   @default(false)
  status      String   @default("ACTIVE") // DRAFT, ACTIVE, PAUSED, CLOSED, EXPIRED (owner); FLAGGED, SUSPENDED (admin)
  // Last day the job can be applied for. Existing rows and admin-posted jobs get 30 days from creation.
  closesAt    DateTime @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now', '+30 days'))"))
  expiryWarningSentAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employer     User          @relation("EmployerPostedJobs", fields: [employerId], references: [id], onDelete: Cascade)
  postedByAdmin User?        @relation("AdminPostedJobs", fields: [postedByAdminId], references: [id], onDelete: SetNull)
  applications Application[]
  reports      Report[]      @relation("ReportedJob")
  savedBy      SavedJob[]
  views        JobView[]
  candidateInvites CandidateInvite[]

  @@index([employerId])
  @@index([postedByAdminId])
  @@index([status, category, createdAt])
  @@index([category, status])
  @@index([location, status])
  @@index([type, status])
  @@index([createdAt])
  @@index([status, closesAt])
  @@index([salaryMax])
  @@index([type, status, closesAt])
}

model Application {
  id          String    @id @default(uuid())
  jobId       String
  seekerId    String
  coverLetter String?
  status      String   @default("SUBMITTED") // SUBMITTED (shown as New), SHORTLISTED, INTERVIEW, OFFERED, REJECTED, HIRED, COMPLETED, CANCELLED
  // When the status last changed (null on older rows: use updatedAt).
  statusChangedAt DateTime?
  // When the employer first moved it out of New. Used for response-time stats.
  firstRespondedAt DateTime?
  // Set once the employer has been reminded that this application sat in New for 14 days.
  newReminderSentAt DateTime?
  // The CV the applicant chose to send, copied at the moment they applied (UPLOADED or BUILDER). Only this employer can open it.
  cvSource    String?
  cvFileUrl   String?
  cvFileName  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime  @updatedAt

  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker    User      @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  agreement Agreement?
  proposals Proposal[]
  review    ApplicationReview?

  @@unique([jobId, seekerId])
  @@index([jobId, status])
  @@index([seekerId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model FreelanceService {
  id          String   @id @default(uuid())
  freelancerId String
  title       String
  description String
  price       Float
  currency    String   @default("GHS")
  deliveryTime String?
  category    String?
  status      String   @default("ACTIVE") // ACTIVE, FLAGGED, SUSPENDED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  freelancer  User     @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  reports     Report[] @relation("ReportedService")
  serviceRequests ServiceRequest[]

  @@index([freelancerId])
  @@index([status, category, createdAt])
  @@index([category, status])
  @@index([createdAt])
}

model ServiceRequest {
  id        String   @id @default(uuid())
  serviceId String
  clientId  String
  message   String
  budget    String?
  timeline  String?
  status    String   @default("PENDING") // PENDING, ACCEPTED, DECLINED, COMPLETED, CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service   FreelanceService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  client    User             @relation("ServiceRequestClient", fields: [clientId], references: [id], onDelete: Cascade)
  agreement Agreement?
  proposals Proposal[]

  @@index([serviceId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model Proposal {
  id               String   @id @default(uuid())
  applicationId    String?
  serviceRequestId String?
  creatorId        String
  recipientId      String
  type             String   // JOB, SERVICE
  status           String   @default("PENDING") // PENDING, COUNTERED, ACCEPTED, REJECTED, EXPIRED, CANCELLED
  title            String
  summary          String
  amount           String?
  timeline         String?
  expiresAt        DateTime?
  acceptedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  application    Application?    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  creator        User            @relation("ProposalCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  recipient      User            @relation("ProposalRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  revisions      ProposalRevision[]

  @@index([applicationId])
  @@index([serviceRequestId])
  @@index([creatorId])
  @@index([recipientId])
  @@index([status])
  @@index([updatedAt])
  @@index([expiresAt])
}

model ProposalRevision {
  id        String   @id @default(uuid())
  proposalId String
  authorId  String
  summary   String
  amount    String?
  timeline  String?
  message   String?
  createdAt DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  author   User     @relation("ProposalRevisionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
  @@index([authorId])
}

model Agreement {
  id               String   @id @default(uuid())
  type             String   // JOB, SERVICE
  title            String
  summary          String?
  amount           String?
  currency         String   @default("GHS")
  status           String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  applicationId    String?  @unique
  serviceRequestId String?  @unique
  employerId       String?
  seekerId         String?
  freelancerId     String?
  clientId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  application    Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  employer       User?           @relation("EmployerAgreements", fields: [employerId], references: [id], onDelete: SetNull)
  seeker         User?           @relation("SeekerAgreements", fields: [seekerId], references: [id], onDelete: SetNull)
  freelancer     User?           @relation("FreelancerAgreements", fields: [freelancerId], references: [id], onDelete: SetNull)
  client         User?           @relation("ClientAgreements", fields: [clientId], references: [id], onDelete: SetNull)
  events         AgreementEvent[]
  milestones     AgreementMilestone[]
  payments       Payment[]
  reviews        Review[]
  disputes       AgreementDispute[]

  @@index([status])
  @@index([createdAt])
  @@index([employerId])
  @@index([seekerId])
  @@index([freelancerId])
  @@index([clientId])
}

model Review {
  id         String   @id @default(uuid())
  agreementId String
  reviewerId String
  revieweeId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  agreement  Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  reviewer   User      @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee   User      @relation("ReviewRecipient", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([agreementId, reviewerId])
  @@index([revieweeId, createdAt])
  @@index([reviewerId, createdAt])
  @@index([rating])
}

model AgreementDispute {
  id             String   @id @default(uuid())
  agreementId    String
  creatorId      String
  counterpartyId String?
  resolverId     String?
  type           String   // PAYMENT, DELIVERY, QUALITY, COMMUNICATION, OTHER
  status         String   @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED, DISMISSED
  title          String
  description    String
  evidenceUrl    String?
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agreement      Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  creator        User      @relation("DisputeCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  counterparty   User?     @relation("DisputeCounterparty", fields: [counterpartyId], references: [id], onDelete: SetNull)
  resolver       User?     @relation("DisputeResolver", fields: [resolverId], references: [id], onDelete: SetNull)
  messages       DisputeMessage[]

  @@index([agreementId, createdAt])
  @@index([creatorId, createdAt])
  @@index([counterpartyId, createdAt])
  @@index([resolverId, createdAt])
  @@index([status, createdAt])
  @@index([type, status])
}

model DisputeMessage {
  id          String   @id @default(uuid())
  disputeId   String
  senderId    String
  content     String
  evidenceUrl String?
  createdAt   DateTime @default(now())

  dispute     AgreementDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  sender      User             @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([disputeId, createdAt])
  @@index([senderId])
}

model VerificationRequest {
  id          String   @id @default(uuid())
  userId      String
  reviewerId  String?
  type        String   // IDENTITY, BUSINESS, PROFESSIONAL
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  details     String
  documentUrl String?   // for a business: the registration certificate
  // Business verification: Registrar-General number, company contact (verified by one-time code) and address.
  registrationNumber String?
  contactEmail String?
  contactPhone String?
  address     String?
  contactVerifiedAt DateTime?
  contactVerifiedVia String?   // EMAIL or PHONE
  reviewNote  String?
  internalNote String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation("VerificationRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewer    User?    @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  contactCodes ContactVerificationCode[]

  @@index([userId, createdAt])
  @@index([reviewerId, createdAt])
  @@index([status, createdAt])
  @@index([type, status])
}

model AgreementEvent {
  id         String   @id @default(uuid())
  agreementId String
  actorId    String?
  eventType  String
  message    String
  fromStatus String?
  toStatus   String?
  createdAt  DateTime @default(now())

  agreement  Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([agreementId, createdAt])
  @@index([actorId])
}

model AgreementMilestone {
  id          String   @id @default(uuid())
  agreementId String
  title       String
  description String?
  amount      String?
  currency    String   @default("GHS")
  dueDate     DateTime?
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  paymentStatus String @default("PENDING") // PENDING, REQUESTED, PAID
  paymentRequestedAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  payments    Payment[]

  @@index([agreementId])
  @@index([status])
  @@index([paymentStatus])
  @@index([dueDate])
}

model Payment {
  id           String   @id @default(uuid())
  agreementId   String
  milestoneId   String
  payerId      String
  payeeId      String
  provider     String   @default("SANDBOX")
  status       String   @default("PENDING") // PENDING, PROCESSING, SUCCEEDED, FAILED, CANCELLED
  amount       String
  currency     String   @default("GHS")
  providerAmount Int?
  reference    String   @unique
  checkoutUrl  String?
  failureReason String?
  
  // Escrow & Payout tracking
  transferId    String?   @unique // Paystack transfer reference for payout
  payoutStatus  String    @default("NONE") // NONE, PENDING, PROCESSING, SUCCESS, FAILED
  payoutAmount  String?   // Net amount sent to freelancer (after fees)
  platformFee   String?   // JobWahala fee if applicable

  payoutAttemptedAt DateTime? // Idempotency guard for payout worker

  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agreement    Agreement          @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  milestone    AgreementMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  payer        User               @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Cascade)
  payee        User               @relation("PaymentPayee", fields: [payeeId], references: [id], onDelete: Cascade)

  @@index([agreementId, createdAt])
  @@index([milestoneId, createdAt])
  @@index([payerId])
  @@index([payeeId])
  @@index([status])
  @@index([payoutStatus])
  @@index([createdAt])
}

model Conversation {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1     User      @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User      @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([user1Id])
  @@index([user2Id])
  @@index([updatedAt])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String?
  attachmentUrl  String?
  attachmentName String?
  attachmentContentType String?
  attachmentSizeBytes Int?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([read])
}

model CVGeneration {
  id        String   @id @default(uuid())
  userId    String
  prompt    String?
  content   String // Markdown or JSON output
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  actionUrl String?
  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([type])
}

model SavedSearch {
  id            String    @id @default(uuid())
  userId        String
  query         String?
  location      String?
  jobType       String?
  emailAlerts   Boolean   @default(true)
  lastAlertedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PayoutAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  bankCode      String   // Paystack bank code (e.g. "MTN", "000013")
  bankName      String
  accountNumber String
  accountName   String
  recipientCode String   // RCP_xxxxx from Paystack
  type          String   @default("mobile_money") // mobile_money or ghipss
  currency      String   @default("GHS")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Report {
  id          String   @id @default(uuid())
  reporterId  String
  jobId       String?
  serviceId   String?
  reportedUserId String?
  reason      String
  status      String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt   DateTime @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  job      Job? @relation("ReportedJob", fields: [jobId], references: [id], onDelete: SetNull)
  service  FreelanceService? @relation("ReportedService", fields: [serviceId], references: [id], onDelete: SetNull)
  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([jobId])
  @@index([serviceId])
  @@index([reportedUserId])
  @@index([status])
  @@index([createdAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// People who asked to be told when something launches (e.g. freelance gigs). Public form, no account needed.
model InterestSignup {
  id        String   @id @default(uuid())
  email     String?
  phone     String?
  source    String
  createdAt DateTime @default(now())

  @@unique([email, source])
  @@unique([phone, source])
  @@index([source, createdAt])
}

// One-time codes sent to a company's contact email (or phone, once SMS is set up). Only a hash is stored.
model ContactVerificationCode {
  id                    String   @id @default(uuid())
  verificationRequestId String
  channel               String   @default("EMAIL") // EMAIL, PHONE
  target                String
  codeHash              String
  expiresAt             DateTime
  attempts              Int      @default(0)
  consumedAt            DateTime?
  createdAt             DateTime @default(now())

  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  @@index([verificationRequestId, createdAt])
}

// Who did what, and why. Admin ids and emails are copied in, so the record outlives the account.
model AdminActionLog {
  id         String   @id @default(uuid())
  adminId    String
  adminEmail String
  action     String   // e.g. VERIFICATION_APPROVED, VERIFICATION_REJECTED, VERIFICATION_NEEDS_INFO
  targetType String   // e.g. VerificationRequest
  targetId   String
  reason     String?
  metadata   String?  // JSON
  // ADMIN or RECRUITER: staff other than admins also leave a trail.
  actorRole  String   @default("ADMIN")
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([adminId, createdAt])
  @@index([createdAt])
}

// One-time codes sent by SMS: sign-up, log-in, adding a phone to an account, and employer verification.
// Only a keyed hash of the code is stored. requestIp lets us cap sends per IP address.
model PhoneOtp {
  id         String   @id @default(uuid())
  phone      String
  purpose    String   // SIGNUP, LOGIN, ADD_PHONE, EMPLOYER_VERIFICATION
  subjectId  String?  // the user (ADD_PHONE) or verification request (EMPLOYER_VERIFICATION) the code is for
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  consumedAt DateTime?
  requestIp  String?
  createdAt  DateTime @default(now())

  @@index([phone, createdAt])
  @@index([requestIp, createdAt])
}

// A job a seeker bookmarked to come back to.
model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

// A job seeker's CV files. Kept apart from the public-ish profile so a file address can never travel
// out with a profile by accident. Both are private uploads, opened only through signed links.
model SeekerCv {
  id               String    @id @default(uuid())
  userId           String    @unique
  uploadedUrl      String?   // a PDF or Word file they uploaded
  uploadedFileName String?
  uploadedAt       DateTime?
  builderUrl       String?   // the Word file made by the CV builder
  builderFileName  String?
  builderSavedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// The employer's private notes and 1-5 rating on an applicant. Kept in its own table so it can never be
// returned to the applicant along with the application. Only the employer who owns the job reads or writes it.
model ApplicationReview {
  id            String   @id @default(uuid())
  applicationId String   @unique
  employerId    String
  rating        Int?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([employerId])
}

// ---------------------------------------------------------------- Courses (a marketplace for training providers)

// A training provider's listing. Public only when status is ACTIVE, reviewStatus is APPROVED and the provider is approved.
model Course {
  id          String   @id @default(uuid())
  providerId  String
  slug        String   @unique
  title       String
  summary     String
  description String
  category    String
  level       String   @default("ALL") // BEGINNER, INTERMEDIATE, ADVANCED, ALL
  isFree      Boolean  @default(false)
  priceGhs    Int?
  durationWeeks Int?
  format      String   @default("ONLINE") // ONLINE, IN_PERSON, HYBRID
  location    String?
  startDatesJson String @default("[]") // ["2026-12-01", ...]
  rollingStart Boolean @default(false)
  certificateOffered Boolean @default(false)
  enrolUrl    String?
  enquiryEnabled Boolean @default(true)
  status      String   @default("ACTIVE") // the provider's own switch: ACTIVE, PAUSED, REMOVED
  reviewStatus String  @default("PENDING") // admin: PENDING, APPROVED, REJECTED, REMOVED
  reviewNote  String?
  reviewedAt  DateTime?
  featuredFrom  DateTime?
  featuredUntil DateTime?
  // Room for hosted lessons later. Not used yet.
  videoProvider String?
  videoRef      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider  User             @relation("ProviderCourses", fields: [providerId], references: [id], onDelete: Cascade)
  skills    CourseSkill[]
  events    CourseEvent[]
  enquiries CourseEnquiry[]
  learners  LearnerCourse[]

  @@index([providerId])
  @@index([status, reviewStatus])
  @@index([category])
  @@index([featuredUntil])
}

// A skill the course teaches (from the shared skills list).
model CourseSkill {
  id       String @id @default(uuid())
  courseId String
  skill    String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, skill])
  @@index([skill])
}

// Views, clicks to the enrolment link and enquiries, per course. This is what providers are billed from, so each
// visitor counts once per day (visitorHash is a keyed hash that includes the day; it cannot be turned back into an IP).
model CourseEvent {
  id          String   @id @default(uuid())
  courseId    String
  type        String   // VIEW, CLICK, ENQUIRY
  visitorHash String
  createdAt   DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, type, visitorHash])
  @@index([courseId, type, createdAt])
}

model CourseEnquiry {
  id        String   @id @default(uuid())
  courseId  String
  userId    String?
  name      String
  email     String?
  phone     String?
  message   String
  status    String   @default("NEW") // NEW, READ
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User?  @relation("CourseEnquiries", fields: [userId], references: [id], onDelete: SetNull)

  @@index([courseId, createdAt])
  @@index([userId])
}

// A course a learner says they completed. With a courseId it can be confirmed by that course's provider.
model LearnerCourse {
  id            String    @id @default(uuid())
  userId        String
  courseId      String?
  title         String
  providerName  String?
  completedOn   DateTime?
  certificateUrl String?
  status        String    @default("SELF") // SELF, REQUESTED, CONFIRMED, DECLINED
  confirmedAt   DateTime?
  confirmedById String?
  decisionNote  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User    @relation("LearnerCourses", fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId, status])
}

// ---------------------------------------------------------------- Billing (Paystack, GHS). Money is whole pesewas.

// What can be bought. Managed by admins: price, duration, credits and what is included change without code.
model Product {
  id          String   @id @default(uuid())
  kind        String   // FEATURED_JOB, JOB_BOOST, JOB_PACK, FEATURED_COURSE, SUBSCRIPTION
  slug        String   @unique
  name        String
  description String   @default("")
  audience    String   @default("EMPLOYER") // EMPLOYER or PROVIDER (a training provider)
  pricePesewas Int
  durationDays Int?    // featured job / boost / featured course
  featuredCredits Int  @default(0) // given by a pack, or every period by a subscription
  boostCredits    Int  @default(0)
  interval    String?  // MONTHLY or YEARLY (subscriptions)
  includesJson String  @default("[]") // ["What is included", ...]
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  paystackPlanCode   String?
  paystackPlanAmount Int?
  // Employer plans: FREE, STARTER or BUSINESS. The credits above are per month for a plan.
  planTier      String?
  teamLimit     Int     @default(1) // seats, the owner included
  monthlyUnlocks Int    @default(0) // CV database profile unlocks per calendar month
  cvDatabase    Boolean @default(false)
  brandedPage   Boolean @default(false)
  hiringReports Boolean @default(false)
  topEmployers  Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments      BillingPayment[]
  subscriptions Subscription[]

  @@index([kind, active])
}

// Every charge: one-off purchases and subscription renewals. The product is copied in, so later price changes never rewrite history.
model BillingPayment {
  id            String   @id @default(uuid())
  userId        String
  productId     String?
  productKind   String
  productName   String
  targetType    String?  // JOB or COURSE
  targetId      String?
  reference     String   @unique
  status        String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED, PARTIALLY_REFUNDED
  subtotalPesewas Int
  vatPesewas    Int
  totalPesewas  Int
  vatRateBps    Int      // 1500 = 15%
  channel       String?  // card, mobile_money ...
  billToName    String?
  billToEmail   String?
  receiptNumber String?  @unique
  paidAt        DateTime?
  refundedPesewas Int    @default(0)
  failureReason String?
  subscriptionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User     @relation("BillingPayments", fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  refunds BillingRefund[]

  @@index([userId, createdAt])
  @@index([status, paidAt])
  @@index([productKind, paidAt])
}

model Subscription {
  id            String   @id @default(uuid())
  userId        String
  productId     String
  status        String   @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELLED, EXPIRED
  paystackSubscriptionCode String? @unique
  paystackCustomerCode     String?
  paystackEmailToken       String?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean @default(false)
  cancelledAt        DateTime?
  reminderSentForPeriodEnd DateTime? // the period end we already sent a renewal reminder for
  pendingProductId   String?   // a downgrade that starts when this period ends
  graceEndsAt        DateTime? // set when a renewal fails: 7 days to put it right
  graceRemindersSent Int       @default(0)
  authorizationCode  String?   // the saved card, so a downgrade can be scheduled
  nextCreditGrantAt  DateTime? // when the next month of plan credits arrives
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User    @relation("Subscriptions", fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([userId, status])
  @@index([status, currentPeriodEnd])
}

// Current credit balances. Spending is one conditional update, so the same credit cannot be spent twice.
model CreditAccount {
  id             String @id @default(uuid())
  userId         String @unique
  featuredCredits Int   @default(0)
  boostCredits    Int   @default(0)
  // Monthly plan credits: they expire at the next monthly grant. Spent before the credits above.
  planFeaturedCredits Int @default(0)
  planBoostCredits    Int @default(0)
  updatedAt      DateTime @updatedAt

  user User @relation("CreditAccount", fields: [userId], references: [id], onDelete: Cascade)
}

// The audit trail behind the balances.
model CreditLedger {
  id        String   @id @default(uuid())
  userId    String
  creditType String  // FEATURE or BOOST
  delta     Int
  reason    String   // PURCHASE, SUBSCRIPTION, SPEND, REFUND, ADMIN_ADJUSTMENT
  paymentId String?
  jobId     String?
  adminId   String?
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// One row of settings the admin can change: VAT, company details for receipts, the receipt counter.
model BillingSettings {
  id           String  @id @default("default")
  vatRatePercent Float  @default(15)
  pricesIncludeVat Boolean @default(true)
  companyName  String  @default("JobWahala")
  companyAddress String @default("")
  companyTin   String  @default("")
  companyEmail String  @default("")
  companyPhone String  @default("")
  receiptFooter String @default("Thank you for using JobWahala.")
  receiptSeq   Int     @default(0)
  // Founding Employer programme: how many companies can be Founding Employers, and the free featured credits each gets.
  foundingLimit   Int @default(50)
  foundingFeaturedCredits Int @default(3)
  // Hiring Service: the "from GHS X" price shown to the public (empty = "ask us for a quote"), and the default replacement guarantee.
  hiringFromPriceGhs Int?
  hiringGuaranteeDays Int @default(90)
  updatedAt    DateTime @updatedAt
}

// Each Paystack webhook is handled once; a repeat is recognised and ignored.
model PaystackEvent {
  id          String   @id @default(uuid())
  eventKey    String   @unique
  type        String
  reference   String?
  outcome     String?
  receivedAt  DateTime @default(now())
}

model BillingRefund {
  id         String   @id @default(uuid())
  paymentId  String
  amountPesewas Int
  reason     String
  adminId    String
  paystackRefundId String?
  status     String   @default("PENDING") // PENDING, PROCESSED, FAILED
  reversedBenefits Boolean @default(false)
  createdAt  DateTime @default(now())

  payment BillingPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

// ---------------------------------------------------------------- Employer plans: team, and job views for hiring reports

// A person who works for a company account. The owner is seat 1; members are the other seats the plan allows.
model TeamMember {
  id         String   @id @default(uuid())
  ownerId    String
  email      String
  userId     String?  // set when they accept the invitation
  status     String   @default("INVITED") // INVITED, ACTIVE, SUSPENDED (over the plan's limit; kept, not deleted)
  inviteTokenHash String @unique
  invitedAt  DateTime @default(now())
  joinedAt   DateTime?

  owner User  @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  user  User? @relation("TeamMembership", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([ownerId, email])
  @@index([userId])
}

// One view of a job page per visitor per day (a keyed hash, never an address).
model JobView {
  id          String   @id @default(uuid())
  jobId       String
  visitorHash String
  createdAt   DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, visitorHash])
  @@index([jobId, createdAt])
}

// ---------------------------------------------------------------- CV database

// Every time a company unlocks a profile (name, phone, email and CV become visible). One row per company and person, so opening it again is free.
model CvUnlock {
  id         String   @id @default(uuid())
  employerId String
  seekerId   String
  actorId    String? // the team member who clicked, if not the owner
  createdAt  DateTime @default(now())

  employer User @relation("CvUnlocksByEmployer", fields: [employerId], references: [id], onDelete: Cascade)
  seeker   User @relation("CvUnlocksOfSeeker", fields: [seekerId], references: [id], onDelete: Cascade)

  @@unique([employerId, seekerId])
  @@index([employerId, createdAt])
  @@index([seekerId, createdAt])
}

// A company opened a person's limited profile. One row per company, person and day. Shown to the person.
model CvProfileView {
  id         String   @id @default(uuid())
  employerId String
  seekerId   String
  day        String // YYYY-MM-DD
  createdAt  DateTime @default(now())

  employer User @relation("CvViewsByEmployer", fields: [employerId], references: [id], onDelete: Cascade)
  seeker   User @relation("CvViewsOfSeeker", fields: [seekerId], references: [id], onDelete: Cascade)

  @@unique([employerId, seekerId, day])
  @@index([seekerId, createdAt])
}

// A person has blocked a company: it cannot find, open, unlock or invite them.
model CvBlock {
  id         String   @id @default(uuid())
  seekerId   String
  employerId String
  createdAt  DateTime @default(now())

  seeker   User @relation("CvBlocksBySeeker", fields: [seekerId], references: [id], onDelete: Cascade)
  employer User @relation("CvBlocksAgainstEmployer", fields: [employerId], references: [id], onDelete: Cascade)

  @@unique([seekerId, employerId])
  @@index([employerId])
}

model SavedCandidateSearch {
  id            String    @id @default(uuid())
  employerId    String
  name          String
  filtersJson   String    @default("{}")
  alertsEnabled Boolean   @default(true)
  lastAlertAt   DateTime?
  createdAt     DateTime  @default(now())

  employer User @relation("SavedCandidateSearches", fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId])
  @@index([alertsEnabled])
}

model CandidateInvite {
  id         String   @id @default(uuid())
  employerId String
  seekerId   String
  jobId      String
  message    String?
  createdAt  DateTime @default(now())

  employer User @relation("CandidateInvitesSent", fields: [employerId], references: [id], onDelete: Cascade)
  seeker   User @relation("CandidateInvitesReceived", fields: [seekerId], references: [id], onDelete: Cascade)
  job      Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([employerId, seekerId, jobId])
  @@index([seekerId, createdAt])
}

// ---------------------------------------------------------------- Employer acquisition

// A secure link that lets the owner of a company JobWahala set up take it over. Only a hash of the link is kept.
model CompanyClaim {
  id          String   @id @default(uuid())
  companyId   String   // the User (employer) the link is for
  tokenHash   String   @unique
  channel     String   @default("LINK") // EMAIL, WHATSAPP, LINK (how the admin sent it)
  sentTo      String?  // the email address or phone number it was sent to
  status      String   @default("ACTIVE") // ACTIVE, CLAIMED, REVOKED
  expiresAt   DateTime
  sendCount   Int      @default(1)
  lastSentAt  DateTime @default(now())
  createdById String?
  revokedAt   DateTime?
  claimedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([companyId, status])
}

// What one company's week looked like, kept so the dashboard can show it and the email is sent once.
model EmployerWeeklyReport {
  id        String   @id @default(uuid())
  employerId String
  weekStart DateTime // Monday 00:00 UTC of the week that was reported
  dataJson  String
  emailSentAt DateTime?
  createdAt DateTime @default(now())

  @@unique([employerId, weekStart])
  @@index([employerId, weekStart])
}

// The admin's list of employers JobWahala has contacted.
model OutreachContact {
  id           String   @id @default(uuid())
  businessName String
  contactName  String?
  contactPhone String?
  contactEmail String?
  sector       String?
  location     String?
  status       String   @default("CONTACTED") // CONTACTED, INTERESTED, POSTED, NOT_INTERESTED
  notes        String?
  followUpAt   DateTime?
  companyId    String?  // the company on JobWahala, once there is one
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, followUpAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------- Hiring Service (JobWahala staff recruit for an employer)

// A member of staff who works on hiring requests (User.role = RECRUITER). Created by an admin; never by sign-up.
model StaffProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String
  title       String?
  phone       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One request: an employer asks JobWahala to recruit for one role.
model HiringRequest {
  id           String   @id @default(uuid())
  reference    String   @unique // HS-2026-0001
  clientId     String
  status       String   @default("NEW") // NEW, AGREED, SOURCING, SHORTLIST_SENT, INTERVIEWING, FILLED, CANCELLED

  // What the employer asked for
  roleTitle    String
  headcount    Int      @default(1)
  salaryMin    Int?
  salaryMax    Int?
  location     String
  startDate    DateTime? // when they want the person to start
  deadline     DateTime? // when they need the shortlist or the hire by
  requirements String
  contactName  String
  contactPhone String
  mustHavesJson String  @default("[]") // optional: if set, each candidate can be rated 1 to 5 on each

  jobId        String?  // the job post made from this request
  assignedRecruiterId String?
  assignedAt   DateTime?

  // The deal, entered by an admin. Money is whole pesewas.
  feePesewas     Int?
  depositPesewas Int?
  guaranteeDays  Int     @default(90)

  sentAt       DateTime? // the first shortlist went to the employer
  filledAt     DateTime?
  guaranteeEndsAt DateTime?
  guaranteeReminderSentAt DateTime?
  replacementCount Int  @default(0)
  cancelledAt  DateTime?
  closeReason  String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([clientId, createdAt])
  @@index([status, createdAt])
  @@index([assignedRecruiterId, status])
  @@index([status, guaranteeEndsAt])
}

// Payments an admin has recorded by hand (Paystack comes later).
model HiringPayment {
  id          String   @id @default(uuid())
  requestId   String
  kind        String   // DEPOSIT, BALANCE or OTHER
  amountPesewas Int
  paidAt      DateTime
  method      String?  // cash, mobile money, bank transfer...
  reference   String?
  note        String?
  recordedById String
  createdAt   DateTime @default(now())

  @@index([requestId, paidAt])
}

// One person in one request. Staff notes and ratings are kept apart from what the employer is shown.
model HiringCandidate {
  id          String   @id @default(uuid())
  requestId   String
  seekerId    String
  source      String   // CV_DATABASE, APPLICANT (applied to the linked job) or DIRECT (by email)
  stage       String   @default("SOURCED") // SOURCED, CONSENT_ASKED, CONSENTED, SHORTLISTED, INTERVIEW, HIRED, DECLINED, DROPPED, NOT_SUITABLE
  consentAskedAt DateTime?
  consentAt   DateTime? // the person agreed to be put forward, and to share their profile, CV and contact details with the employer
  consentVersion String?
  declinedAt  DateTime?
  declineReason String?
  ratingsJson String   @default("{}")
  fitScore    Int?
  clientSummary String? // our short note on this person, which the employer reads
  staffNotes  String?   // never shown to the employer or the candidate
  shortlistedAt DateTime?
  clientDecision String? // INTERVIEW, NOT_SUITABLE or HIRED
  clientDecisionNote String?
  clientDecidedAt DateTime?
  startDate   DateTime? // when the hired person starts
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requestId, seekerId])
  @@index([seekerId, stage])
  @@index([requestId, stage])
}

// The history of a request: every change. CLIENT lines are shown to the employer; STAFF lines are internal.
model HiringEvent {
  id          String   @id @default(uuid())
  requestId   String
  candidateId String?
  actorId     String?
  actorRole   String
  kind        String   // NOTE, STATUS, CANDIDATE, DELIVERY, CLIENT_DECISION, TERMS, PAYMENT, ASSIGNMENT, JOB
  body        String
  visibility  String   @default("STAFF") // STAFF or CLIENT
  createdAt   DateTime @default(now())

  @@index([requestId, createdAt])
}
