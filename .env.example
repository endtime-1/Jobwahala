VITE_API_URL="/api"

# Website error reporting (Sentry browser DSN). Leave empty to turn it off. Personal data is removed before sending.
VITE_SENTRY_DSN=""
# Cloudflare Turnstile site key (public) for the bot check. For testing, Cloudflare publishes 1x00000000000000000000AA (always passes).
VITE_TURNSTILE_SITE_KEY=""

# "Continue with Google": the OAuth client id (public) from Google Cloud Console -> Credentials -> OAuth client ID (Web application).
# Add your site address under "Authorised JavaScript origins". Leave empty to hide the button.
VITE_GOOGLE_CLIENT_ID=""

# WhatsApp channel links shown in the footer and on dashboards. Replace the placeholders once the channels exist;
# a link that is empty or still a placeholder is simply not shown.
VITE_WHATSAPP_CHANNEL_URL="https://whatsapp.com/channel/0029VbEH50105MUaVCzgge2Z"
VITE_WHATSAPP_CHANNEL_JOBS="https://whatsapp.com/channel/REPLACE_ME_JOBS"
VITE_WHATSAPP_CHANNEL_INTERNSHIPS="https://whatsapp.com/channel/REPLACE_ME_INTERNSHIPS"
VITE_WHATSAPP_CHANNEL_EMPLOYERS="https://whatsapp.com/channel/REPLACE_ME_EMPLOYERS"
